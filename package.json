{
  "name": "mcp-excaligen",
  "version": "0.1.0",
  "description": "MCP STDIO server that turns simple flow descriptions into Excalidraw scenes and exports.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsup src/server.ts --format esm --dts --clean",
    "start": "node dist/server.js",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.17.6",
    "@modelcontextprotocol/sdk": "^1.1.0",
    "playwright": "^1.42.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "tsup": "^8.0.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
